/// Freezes "today" for health scores so the sample does not age. Set it to the refresh date for live data.
expression AsOfDate = #date(2026, 10, 15) meta [IsParameterQuery=true, Type="Date", IsParameterQueryRequired=true]
	lineageTag: a6000001-0000-4000-8000-000000000001

	annotation PBI_ResultType = Date

/// "Sample" uses the rows stored in each table. "Csv" reads Seller.csv, Account.csv, Opportunity.csv and Visit.csv from CsvFolder.
expression DataSource = "Sample" meta [IsParameterQuery=true, List={"Sample", "Csv"}, DefaultValue="Sample", Type="Text", IsParameterQueryRequired=true]
	lineageTag: a6000001-0000-4000-8000-000000000002

	annotation PBI_ResultType = Text

/// Folder holding the CSV files, ending in a slash. Only read when DataSource is "Csv".
expression CsvFolder = "C:\pbip-automation-gold\examples\SalesPipeline\data\" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=false]
	lineageTag: a6000001-0000-4000-8000-000000000003

	annotation PBI_ResultType = Text
