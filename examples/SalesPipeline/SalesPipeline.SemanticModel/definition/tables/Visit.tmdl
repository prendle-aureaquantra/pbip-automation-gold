table Visit
	lineageTag: 9148c751-3abc-5914-9ac0-474f28700787

	column VisitNo
		dataType: string
		lineageTag: 06e7d97a-adee-5de2-91dc-1a88f043f0ef
		summarizeBy: none
		sourceColumn: VisitNo

	column SellerNo
		dataType: string
		lineageTag: fadb2e38-b1d0-5730-a74b-82fb7e3ee003
		summarizeBy: none
		sourceColumn: SellerNo

	column VisitDate
		dataType: dateTime
		formatString: yyyy-MM-dd
		lineageTag: f1025f89-ebfc-55c8-b2c5-c9f6e36a072c
		summarizeBy: none
		sourceColumn: VisitDate

	column VisitType
		dataType: string
		lineageTag: 6c9841e3-cf31-5bbd-9dfd-83cc1f8d9ef9
		summarizeBy: none
		sourceColumn: VisitType

	partition Visit = m
		mode: import
		source =
			let
				Sample = Table.FromRows(
					{
						{"V01", "S01", #date(2026, 10, 1), "Discovery"},
						{"V02", "S01", #date(2026, 10, 10), "Demo"},
						{"V03", "S01", #date(2026, 10, 7), "Follow-up"},
						{"V04", "S02", #date(2026, 9, 1), "Discovery"},
						{"V05", "S02", #date(2026, 9, 28), "Demo"},
						{"V06", "S02", #date(2026, 8, 15), "Follow-up"}
					},
					{"VisitNo", "SellerNo", "VisitDate", "VisitType"}
				),
				Source = if DataSource = "Csv" then
						Table.PromoteHeaders(Csv.Document(File.Contents(CsvFolder & "Visit.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
					else
						Sample,
				Typed = Table.TransformColumnTypes(
					Source,
					{
						{"VisitNo", type text},
						{"SellerNo", type text},
						{"VisitDate", type date},
						{"VisitType", type text}
					},
					"en-US"
				)
			in
				Typed

	annotation PBI_ResultType = Table
