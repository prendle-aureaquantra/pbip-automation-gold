table Seller
	lineageTag: a1000001-0000-4000-8000-000000000001

	column SellerNo
		dataType: string
		lineageTag: a1000001-0000-4000-8000-000000000002
		summarizeBy: none
		sourceColumn: SellerNo

	column Name
		dataType: string
		lineageTag: a1000001-0000-4000-8000-000000000003
		summarizeBy: none
		sourceColumn: Name

	column RevenueTarget
		dataType: decimal
		formatString: $#,##0.00
		lineageTag: a1000001-0000-4000-8000-000000000004
		summarizeBy: sum
		sourceColumn: RevenueTarget

	partition Seller = m
		mode: import
		source =
			let
				Sample = Table.FromRows(
					{
						{"S01", "Jordan Hale", 80000.00},
						{"S02", "Priya Shah", 60000.00}
					},
					{"SellerNo", "Name", "RevenueTarget"}
				),
				Source =
					if DataSource = "Csv" then
						Table.PromoteHeaders(
							Csv.Document(File.Contents(CsvFolder & "Seller.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
							[PromoteAllScalars = true]
						)
					else
						Sample,
				Typed = Table.TransformColumnTypes(
					Source,
					{
						{"SellerNo", type text},
						{"Name", type text},
						{"RevenueTarget", type number}
					},
					"en-US"
				)
			in
				Typed

	annotation PBI_ResultType = Table
