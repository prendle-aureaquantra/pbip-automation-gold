table Seller
	lineageTag: 7279edae-701e-5897-9632-531196f9fe1b

	column SellerNo
		dataType: string
		lineageTag: 934ff08f-37f4-505b-be8c-b80f448c42a4
		summarizeBy: none
		sourceColumn: SellerNo

	column Name
		dataType: string
		lineageTag: 30a18a17-1295-560c-a529-16486d80f1f8
		summarizeBy: none
		sourceColumn: Name

	column RevenueTarget
		dataType: decimal
		formatString: $#,##0
		lineageTag: b1b27a52-7300-549c-9c07-28582f4b6a71
		summarizeBy: sum
		sourceColumn: RevenueTarget

	partition Seller = m
		mode: import
		source =
			let
				Sample = Table.FromRows(
					{
						{"S01", "Jordan Hale", 80000.0},
						{"S02", "Priya Shah", 60000.0}
					},
					{"SellerNo", "Name", "RevenueTarget"}
				),
				Source = if DataSource = "Csv" then
						Table.PromoteHeaders(Csv.Document(File.Contents(CsvFolder & "Seller.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
					else
						Sample,
				Typed = Table.TransformColumnTypes(
					Source,
					{
						{"SellerNo", type text},
						{"Name", type text},
						{"RevenueTarget", type number}
					},
					"en-US"
				)
			in
				Typed

	annotation PBI_ResultType = Table
