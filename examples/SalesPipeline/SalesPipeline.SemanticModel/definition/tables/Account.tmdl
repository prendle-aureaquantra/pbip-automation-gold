table Account
	lineageTag: 5a8db672-7455-5739-bfb8-4557b747198f

	column AccountNo
		dataType: string
		lineageTag: 2d5a6d34-681a-5ee4-996e-887b82cb1f21
		summarizeBy: none
		sourceColumn: AccountNo

	column Name
		dataType: string
		lineageTag: d1626183-db1a-53d7-9faa-f3ce2cacd48d
		summarizeBy: none
		sourceColumn: Name

	column PriorYearRevenue
		dataType: decimal
		formatString: $#,##0
		lineageTag: a41e92fa-f483-579e-9f0b-21355e8eae1b
		summarizeBy: sum
		sourceColumn: PriorYearRevenue

	column LastActivityDate
		dataType: dateTime
		formatString: yyyy-MM-dd
		lineageTag: f64cb063-6352-5781-8ea0-823b4b5e84f7
		summarizeBy: none
		sourceColumn: LastActivityDate

	partition Account = m
		mode: import
		source =
			let
				Sample = Table.FromRows(
					{
						{"A01", "Sample Northwind", 42000.0, #date(2026, 10, 12)},
						{"A02", "Sample Lakeside", 18000.0, #date(2026, 9, 1)},
						{"A03", "Sample Harbor", 25000.0, #date(2026, 10, 8)}
					},
					{"AccountNo", "Name", "PriorYearRevenue", "LastActivityDate"}
				),
				Source = if DataSource = "Csv" then
						Table.PromoteHeaders(Csv.Document(File.Contents(CsvFolder & "Account.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
					else
						Sample,
				Typed = Table.TransformColumnTypes(
					Source,
					{
						{"AccountNo", type text},
						{"Name", type text},
						{"PriorYearRevenue", type number},
						{"LastActivityDate", type date}
					},
					"en-US"
				)
			in
				Typed

	annotation PBI_ResultType = Table
